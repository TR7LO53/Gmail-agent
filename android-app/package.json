{
  "name": "ggent-android-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "npm run check && vite build --configLoader runner",
    "build:dev": "npm run check && vite build --configLoader runner --mode development",
    "check": "svelte-check --workspace . --config ./svelte.config.js --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run --configLoader runner",
    "preview": "vite preview",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
